  {
    "case_id": "04",
    "title": "Retire the legacy delivery column",
    "is_held_out": false,
    "category": "env_dependent",
    "defect_confirmed": true,
    "expected_code_only": "ENV-ASK",
    "expected_with_snapshot": "ENV-TP",
    "affected_sites": [
      "elm"
    ],
    "healthy_sites": [
      "cedar"
    ],
    "lambda_smoke_passed": true,
    "lambda_smoke_detail": "Lambda smoke handler and verify_response passed",
    "summary_finding": "SQLite 3.45.1 executes ALTER TABLE deliveries DROP COLUMN legacy_format cleanly, and site 'cedar' (workers-18) succeeds, but site 'elm' still runs 2 replicas of workers-17 issuing 'SELECT id, legacy_format FROM deliveries WHERE delivered_at IS NULL' (inventory-204), failing online with 'OperationalError: no such column: legacy_format'.",
    "reproduction_proof": {
      "sqlite_version": "3.45.1",
      "observation_id": "inventory-204",
      "site_outcomes": {
        "elm": [
          {
            "revision": "workers-17",
            "replicas": 2,
            "status": "error",
            "error": "no such column: legacy_format"
          },
          {
            "revision": "workers-18",
            "replicas": 3,
            "status": "ok",
            "rows": 1
          }
        ],
        "cedar": [
          {
            "revision": "workers-18",
            "replicas": 4,
            "status": "ok",
            "rows": 1
          }
        ]
      },
      "lambda_smoke_response": {
        "commit": "case-04",
        "request_id": "local-smoke",
        "report": "Weekly orders",
        "delivered_this_run": 1,
        "receipt_at": 101,
        "summary": {
          "delivered": 1,
          "pending": 0
        }
      }
    }
  },
