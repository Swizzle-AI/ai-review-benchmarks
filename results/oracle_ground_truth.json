  {
    "case_id": "07",
    "title": "Index pending deliveries",
    "is_held_out": false,
    "category": "clean",
    "defect_confirmed": false,
    "expected_code_only": "TN",
    "expected_with_snapshot": null,
    "affected_sites": [],
    "healthy_sites": [
      "elm",
      "cedar"
    ],
    "lambda_smoke_passed": true,
    "lambda_smoke_detail": "Lambda smoke handler and verify_response passed",
    "summary_finding": "Clean optimization (TN): partial index deliveries_due_by_queue ON deliveries (queue, scheduled_at, id) WHERE delivered_at IS NULL converts full table SCAN + TEMP B-TREE sort into a single COVERING INDEX seek.",
    "reproduction_proof": {
      "baseline_query_plan": [
        "SCAN deliveries",
        "USE TEMP B-TREE FOR ORDER BY"
      ],
      "patched_query_plan": [
        "SEARCH deliveries USING INDEX deliveries_due_by_queue (queue=? AND scheduled_at<?)"
      ],
      "uses_covering_index": true,
      "eliminates_temp_btree_sort": true,
      "lambda_smoke_response": {
        "commit": "case-07",
        "request_id": "local-smoke",
        "report": "Weekly orders",
        "delivered_this_run": 1,
        "receipt_at": 101,
        "summary": {
          "delivered": 1,
          "pending": 0
        }
      }
    }
