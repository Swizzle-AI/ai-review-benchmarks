    "lambda_smoke_detail": "verify_response mismatch: {\"summary\": {\"expected\": {\"delivered\": 1, \"pending\": 0}, \"actual\": {\"delivered\": 1, \"pending\": 0, \"total\": 1}}}",
    "summary_finding": "Clean additive change on pilot/base (TN): summary(db) returns {'delivered': sent, 'pending': waiting, 'total': sent + waiting} (count() is always int >= 0, never NULL). Note: on main, aws/deploy.py:56 checks exact dict equality expected['summary'] == {'delivered': 1, 'pending': 0}, so deploy.py verify requires updating expected['summary'] in lockstep.",
    "reproduction_proof": {
      "empty_table_summary": {
        "delivered": 0,
        "pending": 0,
        "total": 0
      },
      "populated_table_summary": {
        "delivered": 1,
        "pending": 1,
        "total": 2
      },
      "pilot_base_additive_safe": true,
      "lambda_smoke_response": {
        "commit": "case-08",
        "request_id": "local-smoke",
        "report": "Weekly orders",
        "delivered_this_run": 1,
        "receipt_at": 101,
        "summary": {
          "delivered": 1,
          "pending": 0,
          "total": 1
        }
      }
    }
