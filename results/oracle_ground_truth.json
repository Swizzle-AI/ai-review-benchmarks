      "enqueued_ids_at_same_second": [
        3,
        2,
        1
      ],
      "page1_rows": [
        [
          3,
          "Report-C",
          1700000000
        ],
        [
          2,
          "Report-B",
          1700000000
        ]
      ],
      "page1_next_cursor": 1700000000,
      "page2_rows": [],
      "dropped_delivery_ids": [
        1
      ],
      "lambda_smoke_response": {
        "commit": "case-01",
        "request_id": "local-smoke",
        "report": "Weekly orders",
        "delivered_this_run": 1,
        "receipt_at": 101,
        "summary": {
          "delivered": 1,
          "pending": 0
        }
      }
    }
